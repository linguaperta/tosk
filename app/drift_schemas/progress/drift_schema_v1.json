  "fixed_sql": [
    {
      "name": "review_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_log\" (\"id\" TEXT NOT NULL, \"facet_id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"rating\" INTEGER NOT NULL, \"exercise_type\" TEXT NOT NULL, \"input_mode\" TEXT NOT NULL, \"response_ms\" INTEGER NOT NULL, \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"answer\" TEXT NULL, \"session_id\" TEXT NULL, \"mode\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "facet_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"facet_state\" (\"facet_id\" TEXT NOT NULL, \"stability\" REAL NOT NULL, \"difficulty\" REAL NOT NULL, \"due\" INTEGER NOT NULL, \"last_review\" INTEGER NOT NULL, \"reps\" INTEGER NOT NULL, \"lapses\" INTEGER NOT NULL, \"phase\" TEXT NOT NULL, \"step\" INTEGER NULL, PRIMARY KEY (\"facet_id\"));"
        }
      ]
    },
    {
      "name": "mistakes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mistakes\" (\"id\" TEXT NOT NULL, \"facet_id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"exercise_type\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL, \"expected\" TEXT NOT NULL, \"given\" TEXT NOT NULL, \"skill_id\" TEXT NULL, \"note\" TEXT NULL, \"explanation\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tosk.local/schema/course.schema.json",
  "title": "tosk course.yaml",
  "description": "Units, skills (with selection queries) and the course's grammar dimensions. Compiled into meta/units/skills/skill_items/skill_facets.",
  "type": "object",
  "required": ["id", "version", "title", "target", "translations", "persons", "tenses", "units"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "min_app_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "oldest app that can use the pack (meta.min_app_version); default: 0.4.0 for packs with inflection facets"},
    "title": {"$ref": "#/$defs/i18n"},
    "description": {"$ref": "#/$defs/i18n"},
    "target": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "translations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}},
    "unverified": {"type": "boolean"},
    "note_langs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"},
                   "description": "languages every grammar skill needs a note in (default [en, nl])"},
    "attribution": {"type": "string", "minLength": 1, "description": "meta.attribution text; default: generated from the sources used"},
    "license": {"type": "string", "minLength": 1, "description": "licence of the pack content: an SPDX identifier ('CC-BY-SA-4.0') or 'LicenseRef-...' (meta.license; docs/pack-format.md, Credits)"},
    "authors": {"type": "array", "minItems": 1, "description": "who made the pack (meta.authors)",
                "items": {"oneOf": [{"type": "string", "minLength": 1},
                                    {"type": "object", "required": ["name"], "additionalProperties": false,
                                     "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string"},
                                                    "url": {"type": "string"}, "email": {"type": "string"}}}]}},
    "data_sources": {"type": "array", "description": "the sources the content comes from (meta.data_sources)",
                     "items": {"type": "object", "required": ["title"], "additionalProperties": false,
                               "properties": {"id": {"type": "string"}, "title": {"type": "string", "minLength": 1},
                                              "author": {"type": "string"}, "url": {"type": "string"},
                                              "license": {"type": "string"}, "note": {"type": "string"}}}},
    "persons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^.\\s]+$"}},
    "person_labels": {"type": "object", "additionalProperties": {"$ref": "#/$defs/i18n"}},
    "tenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "tense_labels": {"type": "object", "additionalProperties": {"$ref": "#/$defs/i18n"}},
    "articles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "base_features": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/feature"},
                      "description": "grammar features allowed from the start (docs/ARCHITECTURE.md, Grammar gating)"},
    "feature_detectors": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/feature"},
      "description": "construct features and how the pipeline detects them in sentences (pipeline/pipeline/features.py)",
      "additionalProperties": {
        "type": "object", "required": ["type"], "additionalProperties": false,
        "properties": {
          "type": {"enum": ["compound_aux", "modal_infinitive", "words", "irregular_tense", "separable"]},
          "aux": {"type": "string"},
          "verbs": {"type": "array", "items": {"type": "string"}},
          "infinitive_pattern": {"type": "string"},
          "words": {"type": "array", "items": {"type": "string"}},
          "tense": {"type": "string"},
          "particles": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "time_adverbs": {
      "type": "object", "propertyNames": {"type": "string", "minLength": 1},
      "description": "time adverbs (one or more words) -> the tenses they fit; the app never rewrites a sentence with one into another tense",
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
    },
    "inflection_tables": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/key"},
      "description": "non-verb inflection tables (docs/ARCHITECTURE.md, Inflection tables; pipeline/pipeline/inflect.py builds them per language)",
      "additionalProperties": {
        "type": "object", "required": ["pos", "cells"], "additionalProperties": false,
        "properties": {
          "title": {"$ref": "#/$defs/i18n"},
          "pos": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "cells": {"type": "array", "minItems": 2, "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[a-z0-9_]+([.][a-z0-9_]+)*$"}},
          "base": {"type": "string", "description": "the cell equal to the lemma (given, never asked)"},
          "agreement": {"type": "boolean", "description": "cells chosen by agreement: other cells are wrong in an aligned sentence"},
          "labels": {"type": "object", "additionalProperties": {"$ref": "#/$defs/i18n"}}
        }
      }
    },
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "i18n": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z]{2,3}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "feature": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)?$"},
    "names": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
    "strOrList": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]},
    "unit": {
      "type": "object", "required": ["id", "title", "skills"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"$ref": "#/$defs/i18n"},
        "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}}
      }
    },
    "skill": {
      "type": "object", "required": ["id", "kind", "title"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "kind": {"enum": ["vocab", "grammar"]},
        "title": {"$ref": "#/$defs/i18n"},
        "icon": {"type": "string"},
        "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "introduces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/feature"},
                       "description": "grammar features this skill teaches (a verbs skill also introduces tense:{T})"},
        "note": {"type": "string", "description": "path of the English grammar note relative to the course folder; the Dutch one is the same path with .nl.md"},
        "items": {"$ref": "#/$defs/itemsQuery"},
        "verbs": {"$ref": "#/$defs/verbsQuery"},
        "facet": {"enum": ["article", "infl"], "description": "train this facet of the selected items instead of #rec/#prod ('infl': only the #infl:{table} facets of `inflections`)"},
        "inflections": {"type": "object", "required": ["table"], "additionalProperties": false,
                        "description": "train #infl:{table} of the items that inflect (in addition to #rec/#prod unless facet: infl)",
                        "properties": {"table": {"$ref": "#/$defs/strOrList"}}},
        "exercises": {"type": "array", "uniqueItems": true, "items": {"enum": [
          "flashcard", "multiple_choice", "match_pairs", "conj_pick", "conj_grid",
          "sentence_builder", "cloze", "spot_error", "transform"]}},
        "pos": {"type": "object", "additionalProperties": false,
                "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}}
      },
      "oneOf": [
        {"required": ["items"], "not": {"required": ["verbs"]}},
        {"required": ["verbs"], "not": {"required": ["items"]}, "properties": {"kind": {"const": "grammar"}}}
      ]
    },
    "itemsQuery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tags": {"$ref": "#/$defs/strOrList"},
        "pos": {"$ref": "#/$defs/strOrList"},
        "lemmas": {"$ref": "#/$defs/names"},
        "exclude": {"$ref": "#/$defs/names"},
        "top": {"type": "integer", "minimum": 1},
        "min": {"type": "integer", "minimum": 0}
      }
    },
    "verbsQuery": {
      "type": "object", "required": ["tense"], "additionalProperties": false,
      "properties": {
        "tense": {"$ref": "#/$defs/key"},
        "class": {"$ref": "#/$defs/strOrList"},
        "tags": {"$ref": "#/$defs/strOrList"},
        "regular": {"type": "boolean"},
        "aux": {"type": "string"},
        "lemmas": {"$ref": "#/$defs/names"},
        "exclude": {"$ref": "#/$defs/names"},
        "top": {"type": "integer", "minimum": 1},
        "min": {"type": "integer", "minimum": 0}
      }
    }
  }
}
